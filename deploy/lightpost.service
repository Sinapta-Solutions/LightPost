[Unit]
Description=LightPost local publishing scheduler
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
User=lightpost
Group=lightpost
WorkingDirectory=/opt/lightpost
ExecStart=/opt/lightpost/.venv/bin/python -m lightpost
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lightpost/data

[Install]
WantedBy=multi-user.target
